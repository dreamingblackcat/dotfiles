# Template rendered at: {{ now | date "2006-01-02" }}
# Machine: {{ .chezmoi.hostname }} ({{ .chezmoi.os }}/{{ .chezmoi.arch }})

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
# if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
#   source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
# fi

# ── Oh My Zsh ─────────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# FOR VSCODE zsh plugin — set VSCODE based on availability
if command -v code-insiders &> /dev/null; then
  export VSCODE="code-insiders"
elif command -v code &> /dev/null; then
  export VSCODE="code"
fi

plugins=(
  git
  bundler
  dotenv
{{- if eq .chezmoi.os "darwin" }}
  macos
  iterm-tab-color
{{- end }}
  rake
  ruby
  zsh-syntax-highlighting
  zprofile
  asdf
  docker
  docker-compose
  zsh-autosuggestions
  vscode
)

source $ZSH/oh-my-zsh.sh

# ── User Configuration ────────────────────────────────────────────────────────

# iTerm2 tab title: show current directory name
if [ $ITERM_SESSION_ID ]; then
  export PROMPT_COMMAND='echo -ne "\033];${PWD##*/}\007"; ':"$PROMPT_COMMAND";
fi

# Preferred editor
export EDITOR='vim'
export BUNDLER_EDITOR="/usr/local/bin/code-insiders"
if [[ $TERM == xterm ]]; then TERM=xterm-256color; fi

# Solargraph gem config for vscode ruby language server
export SOLARGRAPH_GLOBAL_CONFIG="$HOME/.solargraph.yml"

# Exports for elixir iex shell history
export ERL_AFLAGS="-kernel shell_history enabled"

# Virtualenv workon home
export WORKON_HOME=~/.virtualenvs

# ── Personal Aliases ──────────────────────────────────────────────────────────
alias reload!="source ~/.zshrc"
alias c="clear"
alias ci="code-insiders"
alias z="zellij"
alias exc="exercism"
alias treload!="tmux source ~/.tmux.conf"

# Use eza instead of ls if available
if command -v eza &> /dev/null; then
    alias ls="eza"
fi

# Zoxide with custom aliases
if command -v zoxide &> /dev/null; then
    # Override cd with zoxide
    alias cdo='\cd'  # Original cd command
    eval "$(zoxide init --no-cmd zsh)"
    alias cd='__zoxide_z'
    alias cdi='__zoxide_zi'
fi

# ── Git Helpers ───────────────────────────────────────────────────────────────
function recent_git_branches() {
  git for-each-ref --sort=committerdate refs/heads/ \
    --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(color:red)%(objectname:short)%(color:reset) - %(contents:subject) - %(authorname) (%(color:green)%(committerdate:relative)%(color:reset))'
}

function git_copy_current_branch() {
  git rev-parse --abbrev-ref HEAD | tr -d '\n' | pbcopy
}

alias git_frequent_files="git log --format=format: --name-only | egrep -v '^$' | sort | uniq -c | sort -r"
alias gbre="recent_git_branches"
alias gbc="git_copy_current_branch"

# Push with [ci skip] appended to commit message
function push {
  revised=$(ruby -e "puts \"`git log -1 --pretty=%B`\".chomp  + ' [ci skip]'")
  git commit --amend -m "$revised"
  git push origin $1 $2
}

# Rubocop helpers
function rubocop_modified() {
  git ls-files -m | xargs ls -1 2>/dev/null | grep '\.rb$' | xargs bundle exec rubocop --config=.rubocop.yml
}

function rubocop_diff_with_stable() {
  git diff --name-only origin/stable | xargs ls -1 2>/dev/null | grep '\.rb$' | bundle exec rubocop --config=.rubocop.yml
}

# Rails dev server
function rsd(){
  echo "Starting rails server..."
  USE_S3=true USE_DELAYED_JOB=true BULLET=false bundle exec rails server $1 $2
}

# Rails aliases
alias jobs="USE_S3=TRUE rake jobs:work"
alias rc="bundle exec rails console"
alias push="push"
alias build="git push origin $1"
alias rmg="RAILS_ENV=test bin/rails db:remigrate"
alias load_sanitized="RAILS_ENV=development bundle exec rake workcloud:db:load_sanitized"
alias br="bin/rails"

# Rubocop aliases
alias cop="~/.rvm/gems/ruby-2.2.8/gems/rubocop-0.58.2/exe/rubocop --config=.rubocop.yml"
alias copm="rubocop_modified"
alias copd="rubocop_diff_with_stable"

# Docker aliases
alias dkrc="docker-compose exec -T rails-app bundle exec rails c"

# ── ZSH performance timing ────────────────────────────────────────────────────
# https://blog.mattclemente.com/2020/06/26/oh-my-zsh-slow-to-load/
timezsh() {
  shell=${1-$SHELL}
  for i in $(seq 1 10); do /usr/bin/time $shell -i -c exit; done
}

# ── OS-specific configuration ─────────────────────────────────────────────────
{{- if eq .chezmoi.os "darwin" }}
# macOS-specific paths and settings
export PATH=/opt/homebrew/Cellar/zsh/5.9/bin/:$PATH
export PATH="$PATH:/opt/homebrew/bin"
export HOMEBREW_NO_AUTO_UPDATE=1
export VSCODE=code-insiders

# MySQL 5.7
export PATH="$PATH:/usr/local/mysql/bin"
export DYLD_LIBRARY_PATH="/usr/local/opt/mysql@5.7/lib:$DYLD_LIBRARY_PATH"
export PATH="$PATH:/usr/local/opt/mysql@5.7/bin"

# ImageMagick 6.9
export LDFLAGS="-L/usr/local/opt/imagemagick@6/lib"
export CPPFLAGS="-I/usr/local/opt/imagemagick@6/include"
export PKG_CONFIG_PATH="/usr/local/opt/imagemagick@6/lib/pkgconfig"
export PATH="/usr/local/opt/imagemagick@6/bin:$PATH"

# Docker runtime configuration (based on docker_engine choice)
{{- if eq .docker_engine "colima" }}
export DOCKER_HOST=unix://${HOME}/.colima/default/docker.sock
{{- else if eq .docker_engine "podman" }}
export DOCKER_HOST=unix://${HOME}/.local/share/containers/podman/podman.sock
{{- else if eq .docker_engine "docker-desktop" }}
# Docker Desktop configured
{{- end }}

# Go
export PATH="$PATH:/usr/local/go/bin"

# Homebrew shortcut
alias mbrew=/opt/homebrew/bin/brew

# InfluxDB token (personal monitoring — move to secret management if needed)
# export INFLUX_TOKEN=<your-token>

{{- else if eq .chezmoi.os "linux" }}
# Linux-specific paths and settings

# Neovim (installed via tarball in run_once script)
export PATH="$PATH:/opt/nvim-linux64/bin"

# Zed editor (Wayland workaround)
alias zedl="ZED_ALLOW_EMULATED_GPU=1 WAYLAND_DISPLAY='' zed --foreground"

{{- end }}

# ── Path additions (all platforms) ───────────────────────────────────────────
export PATH="$PATH:$HOME/.rvm/bin"
export PATH="$PATH:$HOME/.cargo/bin"
export PATH="$PATH:$HOME/.local/bin"

# ── Tool initializations ──────────────────────────────────────────────────────
# mise (universal version manager)
eval "$(mise activate zsh)"

# Optional: Ruby version managers (RVM, rbenv, pyenv, nvm)
# Uncomment the source line below if you want to use alternative Ruby managers
# This file contains RVM, rbenv, pyenv, and nvm initialization.
# By default, mise is the primary version manager.
# [ -f "$HOME/.ruby_managers.sh" ] && source "$HOME/.ruby_managers.sh"

# direnv
eval "$(direnv hook zsh)"

# fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# GHCup (Haskell)
[ -f "$HOME/.ghcup/env" ] && source "$HOME/.ghcup/env"

# conda / anaconda
[ -f "$HOME/.conda_shell_init.sh" ] && source "$HOME/.conda_shell_init.sh"

# SSH shell helpers
[ -f ~/.ssh/ssh_shell_helpers.sh ] && source ~/.ssh/ssh_shell_helpers.sh

# Workcloud-specific config (optional, only loaded if present)
[ -f "$HOME/.workcloud_config.sh" ] && source "$HOME/.workcloud_config.sh"

# System limits
ulimit -S -n 10240

# ── Powerlevel10k ─────────────────────────────────────────────────────────────
# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
